PORT=3000
CLIENT_URL=http://localhost:5173

# GitHub OAuth Configuration (Required for device code flow)
# Users must create their own GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub OAuth Callback URL (auto-detected during installation)
# For local development: http://localhost:3000
# For production: Auto-detected from server IP
GITHUB_CALLBACK_URL=http://localhost:3000

# Server IP (auto-detected during installation, leave empty for auto-detection)
SERVER_IP=
