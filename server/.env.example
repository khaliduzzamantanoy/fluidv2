PORT=3000
CLIENT_URL=http://localhost:5173

# GitHub OAuth Configuration (Central Server Only)
# This is for the central Fluid server - users authenticate with YOUR OAuth app
# Create your OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub OAuth Callback URL (Central Server URL)
# For local development: http://localhost:3000
# For production: https://your-fluid-domain.com
GITHUB_CALLBACK_URL=http://localhost:3000

# Central Server URL (for OAuth callbacks)
SERVER_URL=http://localhost:3000
