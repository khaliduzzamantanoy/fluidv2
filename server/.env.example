# Backend Server Port
BACKEND_PORT=3000

# Frontend Server Port (if running separately)
FRONTEND_PORT=5173

# Client URL (for CORS and OAuth)
CLIENT_URL=http://localhost:5173

# GitHub OAuth Configuration (Optional - for centralized auth)
# Users can also authenticate their VPS directly with GitHub using SSH keys
# If you want centralized auth, create your OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub OAuth Callback URL (Central Server URL)
# For local development: http://localhost:3000
# For production: https://your-fluid-domain.com
GITHUB_CALLBACK_URL=http://localhost:3000

# Central Server URL (for OAuth callbacks)
SERVER_URL=

